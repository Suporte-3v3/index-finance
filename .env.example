# GEMINI_API_KEY: Required for Gemini AI API calls.
# In Vercel, configure this exact name in Project Settings > Environment Variables.
# Keep it server-only: never add the VITE_ prefix and never commit a real key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# PostgreSQL local. Em produção, use uma senha exclusiva e injete DATABASE_URL
# pelo gerenciador de segredos da infraestrutura; nunca versione credenciais reais.
POSTGRES_DB="idex_finance"
POSTGRES_USER="idex_app"
POSTGRES_PASSWORD="idex_local_dev_only"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://idex_app:idex_local_dev_only@localhost:5432/idex_finance?schema=public"

# Autenticação real. Gere BETTER_AUTH_SECRET com pelo menos 32 bytes aleatórios
# e configure a URL HTTPS definitiva em produção.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="gere-um-segredo-aleatorio-exclusivo-para-producao"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
